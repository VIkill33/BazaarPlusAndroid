<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bpp_background" android:clipToPadding="false">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="700dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/bpp_market_background" android:scaleType="centerCrop" android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/launcher_body" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="20dp" android:paddingBottom="24dp">
            <TextView style="@style/BppHomeTitle" android:text="@string/app_name" android:accessibilityHeading="true" />
            <ImageView android:layout_width="180dp" android:layout_height="16dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:src="@drawable/bpp_divider" android:contentDescription="@null" />
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="220dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
                <ImageView android:id="@+id/launcher_state_icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:src="@drawable/bpp_help" android:tint="@color/bpp_accent" android:contentDescription="@null" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/launcher_state_title" style="@style/BppHomeStateTitle" android:text="@string/bpp_home_checking_title" android:accessibilityLiveRegion="polite" android:accessibilityHeading="true" />
                    <TextView android:id="@+id/launcher_state_hint" style="@style/BppHomeHint" android:text="@string/bpp_home_checking_hint" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/launcher_status" style="@style/BppHomeMeta" android:layout_marginTop="12dp" />
            <ImageView android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginTop="12dp" android:alpha="0.6" android:src="@drawable/bpp_divider" android:contentDescription="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/launcher_primary" style="@style/BppHomePrimary" android:text="@string/bpp_home_checking_action" android:enabled="false" android:drawableEnd="@drawable/bpp_home_chevron_right" android:drawableTint="#2A170E" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:baselineAligned="false">
                <com.google.android.material.button.MaterialButton android:id="@+id/launcher_history" style="@style/BppHomeTile" android:text="@string/bpp_history" app:icon="@drawable/bpp_home_history" />
                <com.google.android.material.button.MaterialButton android:id="@+id/launcher_settings" style="@style/BppHomeTile" android:layout_marginStart="8dp" android:text="@string/bpp_settings" app:icon="@drawable/bpp_home_cog_outline" />
                <com.google.android.material.button.MaterialButton android:id="@+id/launcher_help" style="@style/BppHomeTile" android:layout_marginStart="8dp" android:text="@string/bpp_help" app:icon="@drawable/bpp_help" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:baselineAligned="false">
                <com.google.android.material.button.MaterialButton android:id="@+id/launcher_refresh" style="@style/BppHomeTile" android:text="@string/bpp_check_again" app:icon="@drawable/bpp_refresh" />
                <com.google.android.material.button.MaterialButton android:id="@+id/launcher_donate" style="@style/BppHomeTile" android:layout_marginStart="8dp" android:text="@string/bpp_donate" app:icon="@drawable/bpp_home_heart_outline" />
                <com.google.android.material.button.MaterialButton android:id="@+id/launcher_github" style="@style/BppHomeTile" android:layout_marginStart="8dp" android:text="Github" app:icon="@drawable/bpp_home_github" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/launcher_purchases" style="@style/BppHomeMore" android:text="@string/bpp_purchases" app:icon="@drawable/bpp_home_history" />
            <com.google.android.material.button.MaterialButton android:id="@+id/launcher_more" style="@style/BppHomeMore" android:text="@string/bpp_more" app:icon="@drawable/bpp_home_wrench_outline" />
            <TextView style="@style/BppHomeMeta" android:text="@string/bpp_community_disclaimer" android:layout_marginTop="20dp" />
            <TextView android:id="@+id/launcher_credit" style="@style/BppHomeMeta" android:text="@string/bpp_credit_plain" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/launcher_version" style="@style/BppHomeMeta" android:textSize="11sp" android:alpha="0.7" android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
