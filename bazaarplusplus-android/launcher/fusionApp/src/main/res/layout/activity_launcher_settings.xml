<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bpp_background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_back"
            style="@style/BppButton" android:layout_width="wrap_content" android:text="@string/bpp_back" />
        <TextView style="@style/BppText" android:text="@string/bpp_settings" android:textSize="28sp"
            android:textStyle="bold" android:layout_marginTop="24dp" android:accessibilityHeading="true" />
        <TextView style="@style/BppText" android:text="@string/bpp_launch_target" android:textSize="20sp"
            android:layout_marginTop="32dp" android:accessibilityHeading="true" />
        <TextView style="@style/BppCaption"
            android:text="@string/bpp_launch_target_description"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/target_current" style="@style/BppText" android:text="@string/bpp_official_target_current"
            android:layout_marginTop="12dp" android:textIsSelectable="true" />
        <com.google.android.material.button.MaterialButton android:id="@+id/target_choose"
            style="@style/BppButton" android:text="@string/bpp_choose_installed_game" android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/target_reset"
            style="@style/BppButton" android:text="@string/bpp_restore_official_game" android:layout_marginTop="8dp"
            android:visibility="gone" />
        <TextView style="@style/BppText" android:text="@string/bpp_preview_position_title" android:textSize="20sp"
            android:layout_marginTop="32dp" android:accessibilityHeading="true" />
        <TextView style="@style/BppCaption" android:text="@string/bpp_preview_position_description"
            android:layout_marginTop="8dp" />
        <RadioGroup android:id="@+id/preview_position" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <RadioButton android:id="@+id/preview_position_default" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/bpp_preview_position_default"
                android:textColor="@color/bpp_text" />
            <RadioButton android:id="@+id/preview_position_left" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/bpp_preview_position_left"
                android:textColor="@color/bpp_text" />
        </RadioGroup>
        <TextView style="@style/BppText" android:text="图鉴与构筑页面样式" android:textSize="20sp"
            android:layout_marginTop="32dp" android:accessibilityHeading="true" />
        <TextView style="@style/BppCaption" android:text="开启后使用暮紫琥珀新样式；关闭后使用原有样式。下次启动游戏时生效。"
            android:layout_marginTop="8dp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/market_panels"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="16dp" android:text="使用新样式" android:textColor="@color/bpp_text" />
        <TextView style="@style/BppText" android:text="@string/bpp_dock_title" android:textSize="20sp"
            android:layout_marginTop="32dp" android:accessibilityHeading="true" />
        <TextView style="@style/BppCaption" android:text="@string/bpp_dock_body"
            android:layout_marginTop="8dp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/dock_collection"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="16dp" android:text="@string/bpp_dock_collection" android:textColor="@color/bpp_text" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/dock_builds"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/bpp_dock_builds" android:textColor="@color/bpp_text" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/dock_preview_mode"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/bpp_dock_preview_mode" android:textColor="@color/bpp_text" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/dock_hold_preview"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/bpp_dock_hold_preview" android:textColor="@color/bpp_text" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/dock_history"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/bpp_history" android:textColor="@color/bpp_text" />
        <TextView style="@style/BppCaption" android:text="@string/bpp_dock_saved"
            android:layout_marginTop="16dp" />
        <TextView style="@style/BppText" android:text="@string/bpp_cache_heading" android:textSize="20sp"
            android:layout_marginTop="32dp" android:accessibilityHeading="true" />
        <TextView android:id="@+id/cache_size" style="@style/BppText" android:text="@string/bpp_cache_measuring"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/cache_policy" style="@style/BppCaption" android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/cache_clear"
            style="@style/BppButton" android:text="@string/bpp_cache_clear" android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
