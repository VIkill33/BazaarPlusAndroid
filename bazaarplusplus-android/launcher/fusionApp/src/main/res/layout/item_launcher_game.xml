<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:minHeight="72dp" android:layout_marginBottom="8dp"
    android:padding="14dp" android:background="@drawable/bpp_panel"
    android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/game_icon" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginEnd="12dp" android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/game_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/bpp_text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/game_package" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="2dp" android:textColor="@color/bpp_muted" android:textSize="12sp" />
        <TextView android:id="@+id/game_version" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="2dp" android:textColor="@color/bpp_muted" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/game_current" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:text="@string/bpp_current" android:textColor="@color/bpp_accent"
        android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
