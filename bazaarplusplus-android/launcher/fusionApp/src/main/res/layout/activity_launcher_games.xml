<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/games_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bpp_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/games_back"
            style="@style/BppButton" android:layout_width="wrap_content" android:text="@string/bpp_back" />
        <TextView style="@style/BppText" android:text="@string/bpp_choose_game" android:textSize="28sp"
            android:textStyle="bold" android:layout_marginTop="24dp" android:accessibilityHeading="true" />
        <TextView style="@style/BppCaption"
            android:text="@string/bpp_games_requirements"
            android:layout_marginTop="8dp" />
        <ProgressBar android:id="@+id/games_progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:indeterminate="true" />
        <TextView android:id="@+id/games_status" style="@style/BppCaption"
            android:text="@string/bpp_games_scanning" android:layout_marginTop="8dp" />
    </LinearLayout>
    <ListView android:id="@+id/games_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" android:paddingHorizontal="24dp"
        android:paddingBottom="24dp" android:clipToPadding="false" android:divider="@android:color/transparent"
        android:dividerHeight="0dp" android:scrollbars="vertical" />
</LinearLayout>
