<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/help_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bpp_background" android:clipToPadding="false">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/help_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/help_back" style="@style/BppButton"
                android:layout_width="wrap_content" android:text="@string/bpp_back_home" />
            <TextView style="@style/BppText" android:text="@string/app_name" android:fontFamily="serif"
                android:textSize="28sp" android:layout_marginTop="28dp" />
            <TextView style="@style/BppText" android:text="@string/bpp_help_title" android:textSize="36sp"
                android:textStyle="bold" android:layout_marginTop="8dp" android:accessibilityHeading="true" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_subtitle"
                android:layout_marginTop="12dp" />
            <ImageView android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginTop="24dp"
                android:src="@drawable/bpp_divider" android:contentDescription="@null" />
            <TextView style="@style/BppHelpHeading" android:text="@string/bpp_help_get_started" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bpp_help_panel" android:padding="20dp">
                <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_step_install" />
                <TextView style="@style/BppCaption" android:text="@string/bpp_help_step_install_body" />
                <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_step_launch" />
                <TextView style="@style/BppCaption" android:text="@string/bpp_help_step_launch_body" />
                <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_step_plugin" />
                <TextView style="@style/BppCaption" android:text="@string/bpp_help_step_plugin_body" />
            </LinearLayout>
            <TextView style="@style/BppHelpHeading" android:text="@string/bpp_help_controls" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_collection_builds" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_collection_builds_body" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_long_press" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_long_press_body" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_hold_preview" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_hold_preview_body" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_history" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_history_body" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_move_controls" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_move_controls_body" />
            <TextView style="@style/BppHelpHeading" android:text="@string/bpp_help_switch_client" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_target_path" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_switch_client_body" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_missing_game" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_missing_game_body" />
            <TextView style="@style/BppHelpHeading" android:text="@string/bpp_help_troubleshooting" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_preparation_failure" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_preparation_failure_body" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_report_problem" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_report_problem_body" />
            <TextView style="@style/BppHelpTitle" android:text="@string/bpp_help_resume" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_resume_body" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/help_start" style="@style/BppPrimaryButton"
                android:text="@string/bpp_back_home" android:layout_marginTop="32dp" />
            <TextView style="@style/BppCaption" android:text="@string/bpp_help_footer" android:gravity="center"
                android:textSize="12sp" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
