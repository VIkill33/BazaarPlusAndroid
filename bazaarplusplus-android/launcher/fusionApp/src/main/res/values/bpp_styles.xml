<resources>
    <style name="BppLauncherTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/bpp_accent</item>
        <item name="colorOnPrimary">@color/bpp_background</item>
        <item name="colorSurface">@color/bpp_surface</item>
        <item name="colorOnSurface">@color/bpp_text</item>
        <item name="android:colorBackground">@color/bpp_background</item>
        <item name="android:windowBackground">@color/bpp_background</item>
        <item name="android:statusBarColor">@color/bpp_background</item>
        <item name="android:navigationBarColor">@color/bpp_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="BppText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bpp_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="BppCaption" parent="BppText">
        <item name="android:textColor">@color/bpp_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="BppButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bpp_text</item>
        <item name="strokeColor">@color/bpp_border</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="BppPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/bpp_primary</item>
        <item name="android:textColor">#2A170E</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <!-- Home-only variants keep secondary screens on their existing button styles. -->
    <style name="BppHomePrimary" parent="BppPrimaryButton">
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="BppHomeTile" parent="BppButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/bpp_surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/bpp_text</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textTop</item>
    </style>
    <style name="BppHomeMore" parent="BppButton">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/bpp_surface</item>
        <item name="iconTint">@color/bpp_text</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconGravity">textStart</item>
    </style>
</resources>
